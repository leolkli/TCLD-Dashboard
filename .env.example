# TCLD Energy Management Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# Azure AD / Entra ID Authentication
VITE_AZURE_CLIENT_ID=your-azure-app-client-id
VITE_AZURE_TENANT_ID=your-azure-tenant-id
VITE_REDIRECT_URI=http://localhost:3000

# API Configuration
VITE_API_BASE_URL=/api

# Azure Synapse (for reference - actual connection is via backend)
VITE_SYNAPSE_ENDPOINT=your-synapse-workspace.sql.azuresynapse.net
